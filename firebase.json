{
  "hosting": [
    {
      "target": "cakes",
      "public": "dist/cakes",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/track/**",
          "destination": "/track.html"
        }
      ]
    },
    {
      "target": "menu",
      "public": "dist/menu",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/track/**",
          "destination": "/track.html"
        }
      ]
    },
    {
      "target": "admin",
      "public": "dist/admin",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
